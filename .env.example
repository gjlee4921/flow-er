# Copy to backend/.env and adjust.
# Folder holding the FCS files and FlowJo workspaces (kept outside the repo).
DATA_DIR=../../data
# Where trained model versions are written (kept outside the repo).
MODELS_DIR=../../models
# One folder per experiment: plan, gates, views, tables, journal and chat (kept outside the repo).
WORKSPACE_DIR=../../workspaces
# Any SQLAlchemy URL; SQLite for local development, Postgres works too.
DATABASE_URL=sqlite:///./flow_er.db
# The web app's agent. OpenAI for now (Responses API); Anthropic slots in behind the same adapter.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
ANTHROPIC_API_KEY=
