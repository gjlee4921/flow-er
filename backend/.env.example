# Copy to .env (this folder) and adjust.
# Research data: datasets, frozen splits (_splits) and model inputs (_cache), kept outside the repo.
# Defaults to <repo>/../data; set only to use another folder.
# DATA_DIR=../../data
# What the app's start page lists (and where uploads and linked folders go): only files no model was
# trained on. Defaults to <repo>/../data/demo; set only to use another folder.
# DATASETS_DIR=../../data/demo
# Where trained model versions are written (kept outside the repo).
# Defaults to <repo>/../models; set only to use another folder.
# MODELS_DIR=../../models
# One folder per experiment: plan, gates, views, tables, journal and chat (kept outside the repo).
# Defaults to <repo>/../workspaces; set only to use another folder.
# WORKSPACE_DIR=../../workspaces
# Any SQLAlchemy URL; SQLite for local development, Postgres works too.
DATABASE_URL=sqlite:///./flow_er.db
# The web app's agent. OpenAI for now (Responses API); Anthropic slots in behind the same adapter.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
ANTHROPIC_API_KEY=
